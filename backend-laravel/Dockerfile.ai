FROM python:3.9-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    REVIEWPRO_MONITORING_DB=/app/data/monitoring.sqlite

WORKDIR /app

RUN groupadd --system reviewpro \
    && useradd --system --gid reviewpro --home-dir /app reviewpro

COPY requirements-ai-runtime.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install --requirement requirements-ai-runtime.txt

COPY ai_service ./ai_service
COPY storage/app/ai/models/review_topic_macro_svm.joblib \
    ./storage/app/ai/models/review_topic_macro_svm.joblib
COPY storage/app/ai/models/review_topic_macro_svm.metadata.json \
    ./storage/app/ai/models/review_topic_macro_svm.metadata.json

RUN mkdir -p /app/data \
    && chown -R reviewpro:reviewpro /app

USER reviewpro

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3)" || exit 1

CMD ["python", "-m", "uvicorn", "ai_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
